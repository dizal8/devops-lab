[Unit]
Description=DZL Web Terminal
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple

User=dizal
Group=dizal

WorkingDirectory=/home/dizal/devops-lab

Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8

ExecStart=/usr/local/bin/ttyd \
  --port 7681 \
  --interface 127.0.0.1 \
  --writable \
  --client-option fontSize=14 \
  --client-option cursorBlink=true \
  --client-option scrollback=15000 \
  /usr/bin/tmux new-session -A -s dzl -c /home/dizal/devops-lab

Restart=always
RestartSec=3

PrivateTmp=true

[Install]
WantedBy=multi-user.target
